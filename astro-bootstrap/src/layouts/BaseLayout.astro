---
import '../styles/global.css';

interface Props {
  description?: string;
  lang?: string;
  title?: string;
}

const { description, lang = 'en', title = 'Astro' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
