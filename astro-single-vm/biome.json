{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.astro",
      "!!**/.vbsmo-runtime",
      "!!.secrets"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": { "rules": { "preset": "recommended" } },
  "html": { "experimentalFullSupportEnabled": true }
}
