{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./resources/js/*"] },
    "types": ["node", "vite/client"]
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts"]
}
