{
  "name": "vbsmo-astro-single-vm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --no-orphans --parallel --filter '@vbsmo/*' dev",
    "build": "bun run --filter '@vbsmo/*' build",
    "test": "bun run --filter '@vbsmo/*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '@vbsmo/*' typecheck",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun --cwd apps/web drizzle-kit generate",
    "db:migrate": "bun apps/web/src/server/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}
