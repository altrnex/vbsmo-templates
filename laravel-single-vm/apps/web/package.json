{
    "name": "@vbsmo/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check -- --threads=4",
        "check:fix": "vp check --fix -- --threads=4",
        "lint": "vendor/bin/pint --test && vp check -- --threads=4",
        "lint:fix": "vendor/bin/pint && vp check --fix -- --threads=4",
        "typecheck": "vue-tsc --noEmit && vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/phpunit"
    },
    "dependencies": {
        "@inertiajs/core": "3.11.0",
        "@inertiajs/vite": "3.11.0",
        "@inertiajs/vue3": "3.11.0",
        "@lucide/vue": "1.77.0",
        "@vueuse/core": "12.8.2",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "laravel-vite-plugin": "3.2.1",
        "reka-ui": "2.11.0",
        "tailwind-merge": "3.7.1",
        "tailwindcss": "4.3.5",
        "tw-animate-css": "1.4.0",
        "vue": "3.5.46",
        "vue-input-otp": "0.3.2",
        "vue-sonner": "2.0.9"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "0.1.11",
        "@tailwindcss/vite": "4.3.5",
        "@types/node": "22.20.5",
        "@vitejs/plugin-vue": "6.0.11",
        "concurrently": "10.0.7",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vue-tsc": "3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
        "@tailwindcss/oxide-win32-x64-msvc": "4.3.5",
        "lightningcss-linux-x64-gnu": "1.33.0",
        "lightningcss-win32-x64-msvc": "1.33.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
