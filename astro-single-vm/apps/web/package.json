{
  "name": "@vbsmo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --ignore-lock --host 127.0.0.1",
    "build": "bun --bun astro build",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "start": "bun dist/server/entry.mjs"
  },
  "dependencies": {
    "@vbsmo/db": "workspace:*",
    "astro": "7.4.8",
    "hono": "4.13.16",
    "drizzle-orm": "0.45.4",
    "@astrojs/node": "11.1.11",
    "sonner": "2.0.8",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "class-variance-authority": "0.7.1",
    "@astrojs/react": "7.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "tw-animate-css": "1.4.0"
  }
}
