{
  "name": "@vbsmo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev --ignore-lock --host 127.0.0.1",
    "build": "bun --bun astro build",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "start": "bun dist/server/entry.mjs"
  },
  "dependencies": {
    "@vbsmo/db": "workspace:*",
    "astro": "7.4.8",
    "hono": "4.13.16",
    "drizzle-orm": "0.45.4",
    "@astrojs/node": "11.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "@types/bun": "1.4.4"
  }
}
