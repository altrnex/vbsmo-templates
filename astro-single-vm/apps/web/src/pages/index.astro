---
import { NotesHelp } from "../components/NotesHelp";
import { Button } from "../components/ui/button";
import { Input } from "../components/ui/input";
import { Label } from "../components/ui/label";
import Layout from "../layouts/Layout.astro";
import { getDb } from "../server/db.ts";
export const prerender = false;

import { notes } from "@vbsmo/db/schema";

const saved = await getDb().select().from(notes);
---
<Layout>
  <main class="mx-auto max-w-xl space-y-6 p-8">
    <h1 class="text-3xl font-semibold">Notes</h1>
    <NotesHelp client:load />
    <form class="flex items-center gap-2">
      <Label htmlFor="body">New note</Label>
      <Input id="body" name="body" maxLength={500} required />
      <Button type="submit">Save</Button>
    </form>
    <p id="error" role="alert"></p>
    <ul>{saved.map((note) => <li>{note.body}</li>)}</ul>
  </main>
</Layout>

<script>
  import { hc } from "hono/client";
  import type { ApiType } from "../server/api.ts";

  const client = hc<ApiType>("/");
  document.querySelector<HTMLFormElement>("form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const body = document.querySelector<HTMLInputElement>("#body")?.value ?? "";
    const error = document.querySelector<HTMLElement>("#error");
    try {
      const response = await client.api.notes.$post({ json: { body } });
      if (response.ok) window.location.reload();
      else if (error) error.textContent = "Could not save note.";
    } catch {
      if (error) error.textContent = "Could not save note.";
    }
  });
</script>
